# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES SETUP GUIDE
# ═══════════════════════════════════════════════════════════════════════════════
# This file explains all environment variables needed for the application.

# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Files: server/.env and client/.env
# These are already configured for your local setup

# ─── PRODUCTION (Vercel) ───────────────────────────────────────────────────────
# Set these in Vercel Dashboard: Settings → Environment Variables
# DO NOT commit sensitive information to GitHub

# Database
# MongoDB Atlas connection string
# NOTE: Keep this secret! Only set in Vercel environment variables
MONGODB_URI=mongodb+srv://vicharan:1234@cluster0.a5ch7ns.mongodb.net/?appName=Cluster0

# Server Configuration
PORT=5001
NODE_ENV=production

# JWT Authentication
# These are your configured secrets:
JWT_SECRET=8f3c9a7e2d4b6f1c9a5e7d3b8f6c2a9e7d4c1b8f5a9d3e7c2b6f8a1d4c9e7b3
JWT_REFRESH_SECRET=5c8a1e9d3f7b2c6a9e4d8f1b3c7e5a9d2f6b8c1e4d9a7f3b6c2e8d5f1a9c7b4
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client URL (for CORS)
# Your Vercel deployment domain:
CLIENT_URL=https://vicharanshala-faq-generation.vercel.app

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ─── CLIENT PRODUCTION ─────────────────────────────────────────────────────────
# Set in Vercel: Settings → Environment Variables
VITE_API_URL=https://vicharanshala-faq-generation.vercel.app/api/v1
VITE_APP_NAME=WiseFlow FAQ Platform
